{
  "manifest_version": 3,
  "name": "TruePath TV Optimizer",
  "version": "1.1.0",
  "description": "Personal tool: lets Claude Code set TradingView strategy inputs and export Strategy Tester reports through a local MCP server, and screenshots TruePath Bot trades for a review journal.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "TruePath TV Optimizer",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
